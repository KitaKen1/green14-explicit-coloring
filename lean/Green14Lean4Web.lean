      apply mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) (by positivity)
      linarith only [hgamma]
    _ < Real.exp 270 * Real.exp (-270) :=
      mul_lt_mul_of_pos_right (small.trans_le great) (Real.exp_pos _)
    _ = 1 := by rw [← Real.exp_add]; norm_num
  have : remaining steps < 1 := by exact_mod_cast hfinal
  omega

noncomputable def coloring (shift : ZMod v → Option (ZMod w)) (n : ℕ) : Fin 2 :=
  open Classical in
  if RedAt shift n then 0 else 1

/-- The geometric and covering certificates suffice for the exact FC answer body. -/
theorem valid_of_cover (C : Set (ZMod v)) (free : ColumnsFree C)
    (shift : ZMod v → Option (ZMod w))
    (occupied : ∀ a s, shift a = some s → a ∈ C)
    (cover : ∀ a d : ℕ, 1 ≤ a → 0 < d → a + (r - 1) * d ≤ N →
      ∃ j < r, RedAt shift (a + j * d)) :
    ValidAnswer ⟨r, fun x => coloring shift x.val⟩ := by
  classical
  refine ⟨numerical_bounds.1, ?_⟩
  rintro (hr | hb)
  · obtain ⟨a, d, ha, hd, hlast, hmono⟩ :=
      (hasMono_iff (N := N) (by decide : 2 ≤ 3) (coloring shift) 0).mp hr
    have red (j : ℕ) (hj : j < 3) : RedAt shift (a + j * d) := by
      by_contra h
      simpa [coloring, h] using hmono j hj
    have hred := noRedTriple C free shift occupied
      (x := a) (y := a + d) (z := a + 2 * d) (by omega) (by omega) hlast (by omega)
      (by simpa using red 0 (by decide)) (by simpa using red 1 (by decide)) (red 2 (by decide))
    omega
  · have hlen : 2 ≤ r := le_trans (by decide : 2 ≤ 3) numerical_bounds.1
    obtain ⟨a, d, ha, hd, hlast, hmono⟩ :=
      (hasMono_iff (N := N) hlen (coloring shift) 1).mp hb
    obtain ⟨j, hj, hred⟩ := cover a d ha hd hlast
    simpa [coloring, hred] using hmono j hj

end Green14

namespace Green14.Greedy

/-- A cubic model with relation X³ = X + constant. -/
structure Instance where
  q : ℕ
  constant : ℕ
  r : ℕ
  n : ℕ
  digits : ℕ

def Instance.v (inst : Instance) : ℕ := inst.q ^ 2 + inst.q + 1

def Instance.w (inst : Instance) : ℕ := 3 ^ inst.digits

abbrev Coefficients := ℕ × ℕ × ℕ

def multiply (inst : Instance) (x y : Coefficients) : Coefficients :=
  let (a, b, c) := x
  let (d, e, f) := y
  -- Reduce X³ and X⁴ using the fixed cubic relation.
  let high3 := b * f + c * e
  let high4 := c * f
  ((a * d + inst.constant * high3) % inst.q,
   (a * e + b * d + high3 + inst.constant * high4) % inst.q,
   (a * f + b * e + c * d + high4) % inst.q)

def powerAux (inst : Instance) : ℕ → ℕ → Coefficients
  | 0, _ => (1, 0, 0)
  | fuel + 1, exponent =>
    if exponent = 0 then (1, 0, 0)
    else
      let half := powerAux inst fuel (exponent / 2)
      let squared := multiply inst half half
      if exponent % 2 = 0 then squared else multiply inst squared (0, 1, 0)

def powerX (inst : Instance) (exponent : ℕ) : Coefficients :=
  powerAux inst exponent exponent

def eligible (inst : Instance) (a : ℕ) : Bool := (powerX inst a).2.2 == 0

def allowedDigits : ℕ → ℕ → Bool
  | 0, n => n == 0
  | m + 1, n => n % 3 ≤ 1 && allowedDigits m (n / 3)

abbrev Shifts := List (ℕ × ℕ)
abbrev Progression := ℕ × ℕ

def inTranslation (inst : Instance) (b shift : ℕ) : Bool :=
  allowedDigits inst.digits ((b % inst.w + inst.w - shift) % inst.w)

def isRed (inst : Instance) (selected : Shifts) (n : ℕ) : Bool :=
  match selected.find? (fun pair => pair.1 == n % inst.v) with
  | none => false
  | some (_, shift) => inTranslation inst (n / inst.v) shift

def fields (inst : Instance) (p : Progression) : List ℕ :=
  (List.range inst.r).map (fun j => p.1 + j * p.2)

def progressions (inst : Instance) : List Progression :=
  (List.range ((inst.n - 1) / (inst.r - 1))).flatMap fun step =>
    let d := step + 1
    (List.range (inst.n - (inst.r - 1) * d)).map fun start => (start + 1, d)

def score (inst : Instance) (live : List Progression) (a shift : ℕ) : ℕ :=
  (live.filter fun p => (fields inst p).any fun n =>
    n % inst.v == a && inTranslation inst (n / inst.v) shift).length

def live (inst : Instance) (selected : Shifts) : List Progression :=
  (progressions inst).filter fun p => !(fields inst p).any (isRed inst selected)

def used (selected : Shifts) (a : ℕ) : Bool :=
  selected.any fun pair => pair.1 == a

def candidates (inst : Instance) (selected : Shifts) : List (ℕ × ℕ) :=
  (List.range inst.v).flatMap fun a =>
    if eligible inst a && !used selected a then
      (List.range inst.w).map fun shift => (a, shift)
    else []

/-- `List.argmax` returns the first maximizer in the list, whose order is lexicographic. -/
def bestStep (inst : Instance) (selected : Shifts) : Option (ℕ × ℕ) :=
  let rating := fun b : ℕ × ℕ => score inst (live inst selected) b.1 b.2
  ((candidates inst selected).argmax rating).filter fun b => 0 < rating b

def advance (inst : Instance) (selected : Shifts) : Shifts :=
  match bestStep inst selected with
  | none => selected
  | some next => selected ++ [next]

def run (inst : Instance) : ℕ → Shifts → Shifts
  | 0, selected => selected
  | fuel + 1, selected =>
    match bestStep inst selected with
    | none => selected
    | some next => run inst fuel (selected ++ [next])

def initial : Shifts := [(0, 0), (1, 0)]

def full : Instance := ⟨q, 2, r, N, 56⟩

def small : Instance := ⟨5, 2, 18, 68, 1⟩

def color (n : ℕ) : Fin 2 :=
  let a := n % full.v
  let red :=
    if a == 0 || a == 1 then inTranslation full (n / full.v) 0
    else if eligible full a then isRed full (run full steps initial) n
    else false
  if red then 0 else 1

/-- The algorithmic candidate with the exact domain of the upstream answer. -/
def answer : Answer := ⟨r, fun x => color x.val⟩

set_option maxRecDepth 4096 in
set_option maxHeartbeats 500000 in
theorem smallModel :
    run small 4 initial = [(0, 0), (1, 0), (18, 0), (3, 1)] := by
  decide

end Green14.Greedy

namespace Green14.Singer

open Polynomial

abbrev F := ZMod q
instance : Fact q.Prime := ⟨q_prime⟩

noncomputable def cubic : F[X] := X ^ 3 - X - 2

theorem cubic_monic : cubic.Monic := by
  have hx : (X ^ 3 - X : F[X]).Monic :=
    (monic_X.pow 3).sub_of_left (by simp)
  exact hx.sub_of_left (by
    have hh := natDegree_sub_eq_left_of_natDegree_lt (p := (X ^ 3 : F[X])) (q := X) (by simp)
    rw [degree_eq_natDegree hx.ne_zero, hh]
    have hc : (2 : F[X]).degree ≤ 0 := by
      simpa only [map_ofNat] using (degree_C_le : (C (2 : F)).degree ≤ 0)
    exact hc.trans_lt (by simp))

theorem cubic_degree : cubic.natDegree = 3 := by
  unfold cubic
  rw [natDegree_sub_eq_left_of_natDegree_lt, natDegree_sub_eq_left_of_natDegree_lt]
  · simp
  · simp
  · rw [natDegree_sub_eq_left_of_natDegree_lt (by simp : (X : F[X]).natDegree < (X ^ 3 : F[X]).natDegree)]
    simp

def evalCoeffs {R : Type*} [CommRing R] [Algebra F R]
    (x : R) (a : Greedy.Coefficients) : R :=
  algebraMap F R (a.1 : F) + algebraMap F R (a.2.1 : F) * x +
    algebraMap F R (a.2.2 : F) * x ^ 2

theorem evalMultiply {R : Type*} [CommRing R] [Algebra F R]
    (x : R) (hx : x ^ 3 = x + 2) (a b : Greedy.Coefficients) :
    evalCoeffs x (Greedy.multiply Greedy.full a b) = evalCoeffs x a * evalCoeffs x b := by
  rcases a with ⟨a0, a1, a2⟩
  rcases b with ⟨b0, b1, b2⟩
  have hx4 : x ^ 4 = x ^ 2 + 2 * x := by
    rw [show (4 : ℕ) = 3 + 1 by decide, pow_succ, hx]
    ring
  simp only [Greedy.multiply, Greedy.full, evalCoeffs, ZMod.natCast_mod,
    Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat, map_add, map_mul, map_ofNat, map_natCast]
  linear_combination
    -(↑a1 * ↑b2 + ↑a2 * ↑b1 : R) * hx - (↑a2 * ↑b2 : R) * hx4

theorem evalPowerAux {R : Type*} [CommRing R] [Algebra F R]
    (x : R) (hx : x ^ 3 = x + 2) (fuel n : ℕ) (hn : n ≤ fuel) :
    evalCoeffs x (Greedy.powerAux Greedy.full fuel n) = x ^ n := by
  induction fuel generalizing n with
  | zero =>
    have he : n = 0 := by omega
    subst n
    simp [Greedy.powerAux, evalCoeffs]
  | succ fuel ih =>
    simp only [Greedy.powerAux]
    split
    · subst n
      simp [evalCoeffs]
    · have hhalf : n / 2 ≤ fuel := by omega
      have hn' : n / 2 + n / 2 + n % 2 = n := by omega
      have hr : x ^ n = x ^ (n / 2) * x ^ (n / 2) * x ^ (n % 2) := by
        rw [← pow_add, ← pow_add, hn']
      rw [hr]
      split
      · rename_i h
        simp [evalMultiply x hx, ih _ hhalf, h]
      · have h : n % 2 = 1 := by omega
        have hone : evalCoeffs x (0, 1, 0) = x := by simp [evalCoeffs]
        rw [evalMultiply x hx, evalMultiply x hx, ih _ hhalf, hone, h, pow_one]

theorem evalPower {R : Type*} [CommRing R] [Algebra F R]
    (x : R) (hx : x ^ 3 = x + 2) (n : ℕ) :
    evalCoeffs x (Greedy.powerX Greedy.full n) = x ^ n :=
  evalPowerAux x hx n n le_rfl

set_option maxRecDepth 4096 in
set_option maxHeartbeats 3000000 in
theorem frobenius_remainder :
    Greedy.powerX Greedy.full q = (645765156831, 2905943205739, 15168618137650) := by
  decide

theorem no_cubic_root (x : F) : ¬ cubic.IsRoot x := by
  intro h
  have hf : x ^ 3 - x - 2 = 0 := by simpa [Polynomial.IsRoot, cubic] using h
  have hx : x ^ 3 = x + 2 := by linear_combination hf
  have hy : (645765156831 : F) + 2905943205738 * x + 15168618137650 * x ^ 2 = 0 := by
    have he := evalPower x hx q
    have hp : x ^ q = x := by simp
    rw [frobenius_remainder, hp] at he
    simp [evalCoeffs] at he
    linear_combination he
  have b0 : (17124145504135 : F) * (-2) + 22369007678038 * 645765156831 = 1 := by decide
  have b1 : (-17124145504135 : F) - 2 * 30471395711364 +
      22369007678038 * 2905943205738 + 8999629044500 * 645765156831 = 0 := by decide
  have b2 : (-30471395711364 : F) + 22369007678038 * 15168618137650 +
      8999629044500 * 2905943205738 + 23411242905704 * 645765156831 = 0 := by decide
  have b3 : (17124145504135 : F) + 8999629044500 * 15168618137650 +
      23411242905704 * 2905943205738 = 0 := by decide
  have b4 : (30471395711364 : F) + 23411242905704 * 15168618137650 = 0 := by decide
  have hone : (1 : F) = 0 := by
    linear_combination (17124145504135 + 30471395711364 * x) * hf +
      (22369007678038 + 8999629044500 * x + 23411242905704 * x ^ 2) * hy -
      b0 - x * b1 - x ^ 2 * b2 - x ^ 3 * b3 - x ^ 4 * b4
  exact one_ne_zero hone

theorem cubic_irreducible : Irreducible cubic :=
  Polynomial.irreducible_of_degree_le_three_of_not_isRoot (by simp [cubic_degree]) no_cubic_root

abbrev K := AdjoinRoot cubic
instance : Fact (Irreducible cubic) := ⟨cubic_irreducible⟩

end Green14.Singer

namespace Green14

/-- Nonzero differences of members have unique ordered representations. -/
def UniqueDifferences {G : Type*} [AddCommGroup G] (C : Finset G) : Prop :=
  ∀ x ∈ C, ∀ y ∈ C, ∀ z ∈ C, ∀ u ∈ C,
    x ≠ y → x - y = z - u → x = z ∧ y = u

theorem UniqueDifferences.columnsFree {C : Finset (ZMod v)}
    (hs : UniqueDifferences C) : ColumnsFree (C : Set (ZMod v)) := by
  intro x hx y hy z hz h
  by_cases e : x = y
  · subst x
    exact ⟨rfl, add_left_cancel h⟩
  · have h' : x - y = y - z := by linear_combination h
    exact (e (hs x hx y hy y hy z hz e h').1).elim

section Moments

variable {G : Type*} [AddCommGroup G] [Fintype G] [DecidableEq G]

noncomputable def bit (C : Finset G) (x : G) : ℝ := if x ∈ C then 1 else 0

noncomputable def overlap (C S : Finset G) (t : G) : ℝ :=
  ∑ i ∈ S, bit C (t + i)

theorem sum_bit_translate (C : Finset G) (i : G) :
    ∑ t : G, bit C (t + i) = C.card := by
  calc
    _ = ∑ t : G, bit C t := Equiv.sum_comp (Equiv.addRight i) (bit C)
    _ = _ := by simp [bit]

theorem overlap_first (C S : Finset G) :
    ∑ t : G, overlap C S t = (S.card : ℝ) * C.card := by
  unfold overlap
  rw [Finset.sum_comm]
  simp [sum_bit_translate]

theorem bit_pair_bound (C : Finset G) (hs : UniqueDifferences C) (i j : G) :
    ∑ t : G, bit C (t + i) * bit C (t + j) ≤ if i = j then (C.card : ℝ) else 1 := by
  classical
  by_cases h : i = j
  · subst j
    have hprod (x : G) : bit C x * bit C x = bit C x := by
      by_cases hx : x ∈ C <;> simp [bit, hx]
    simp [hprod, sum_bit_translate]
  · let good := (Finset.univ : Finset G).filter fun t => t + i ∈ C ∧ t + j ∈ C
    have hc : good.card ≤ 1 := by
      rw [Finset.card_le_one]
      intro x hx y hy
      have hx' := (Finset.mem_filter.mp hx).2
      have hy' := (Finset.mem_filter.mp hy).2
      have hne : x + i ≠ x + j := fun he => h (add_left_cancel he)
      have hdiff : (x + i) - (x + j) = (y + i) - (y + j) := by abel
      exact add_right_cancel (hs _ hx'.1 _ hx'.2 _ hy'.1 _ hy'.2 hne hdiff).1
    calc
      _ = (good.card : ℝ) := by
        have product (x : G) : bit C (x + i) * bit C (x + j) =
            if x + i ∈ C ∧ x + j ∈ C then 1 else 0 := by
          by_cases hi : x + i ∈ C <;> by_cases hj : x + j ∈ C <;> simp [bit, hi, hj]
        simp [product, good]
      _ ≤ _ := by simp [h]; exact_mod_cast hc

theorem overlap_second (C S : Finset G) (hs : UniqueDifferences C) :
    ∑ t : G, overlap C S t ^ 2 ≤
      (S.card : ℝ) * ((C.card : ℝ) + S.card - 1) := by
  classical
  have expand (t : G) : overlap C S t ^ 2 =
      ∑ i ∈ S, ∑ j ∈ S, bit C (t + i) * bit C (t + j) := by
    rw [overlap, pow_two, Finset.sum_mul]
    exact Finset.sum_congr rfl (fun i _ => Finset.mul_sum ..)
  simp only [expand]
  rw [Finset.sum_comm]
  calc
    _ ≤ ∑ _i ∈ S, ((C.card : ℝ) + S.card - 1) := by
      apply Finset.sum_le_sum
      intro i hi
      rw [Finset.sum_comm]
      calc
        _ ≤ ∑ j ∈ S, if i = j then (C.card : ℝ) else 1 :=
          Finset.sum_le_sum (fun j _ => bit_pair_bound C hs i j)
        _ = _ := by
          have h (j : G) : (if i = j then (C.card : ℝ) else 1) =
              1 + (if j = i then (C.card : ℝ) - 1 else 0) := by
            by_cases he : i = j <;> simp [he, eq_comm]
          simp [h, Finset.sum_add_distrib, hi]
          ring
    _ = _ := by simp; ring

theorem overlap_variance (C S : Finset G) (hs : UniqueDifferences C) :
    let μ := (S.card : ℝ) * C.card / Fintype.card G
    ∑ t : G, (overlap C S t - μ) ^ 2 ≤
      (S.card : ℝ) * ((C.card : ℝ) + S.card - 1) - Fintype.card G * μ ^ 2 := by
  classical
  dsimp only
  set μ : ℝ := (S.card : ℝ) * C.card / Fintype.card G
  have hcard : (Fintype.card G : ℝ) ≠ 0 := by positivity
  have hμ : (Fintype.card G : ℝ) * μ = (S.card : ℝ) * C.card := by
    dsimp [μ]
    field_simp
  have expand (t : G) : (overlap C S t - μ) ^ 2 =
      overlap C S t ^ 2 - overlap C S t * (2 * μ) + μ ^ 2 := by ring
  simp only [expand, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.sum_mul,
    Finset.sum_const, Finset.card_univ, nsmul_eq_mul, overlap_first]
  nlinarith only [overlap_second C S hs, congrArg (fun a : ℝ => a * (2 * μ)) hμ]

end Moments

end Green14

namespace Green14.Singer

open Polynomial

noncomputable section

theorem mk_low_injective {f g : F[X]} (hf : f.natDegree ≤ 2) (hg : g.natDegree ≤ 2)
    (h : AdjoinRoot.mk cubic f = AdjoinRoot.mk cubic g) : f = g := by
  have hdvd : cubic ∣ f - g := AdjoinRoot.mk_eq_zero.mp (by rw [map_sub, h, sub_self])
  by_contra he
  have hl := natDegree_le_of_dvd hdvd (sub_ne_zero.mpr he)
  rw [cubic_degree] at hl
  exact (by decide : ¬3 ≤ 2) (hl.trans (natDegree_sub_le_of_le hf hg))

/-- Normalized representatives of the lines of the plane spanned by 1 and X. -/
def line : Option F → F[X]
  | none => 1
  | some t => X + C t

theorem line_monic (i : Option F) : (line i).Monic := by
  cases i <;> simp [line, monic_X_add_C]

@[simp] theorem line_degree_some (i : F) : (line (some i)).natDegree = 1 := by
  simp [line]

theorem line_degree (i : Option F) : (line i).natDegree ≤ 1 := by
  cases i <;> simp [line]

theorem line_injective : Function.Injective line := by
  intro i j h
  cases i <;> cases j
  · rfl
  · have hn := congrArg natDegree h
    simp [line] at hn
  · have hn := congrArg natDegree h
    simp [line] at hn
  · simpa [line] using h

theorem line_product_unique (a b c d : Option F)
    (h : line a * line b = line c * line d) :
    (a = c ∧ b = d) ∨ (a = d ∧ b = c) := by
  have cancel {i j k : Option F} (e : line i * line j = line i * line k) : j = k :=
    line_injective (mul_left_cancel₀ (line_monic i).ne_zero e)
  cases a with
  | none =>
    by_cases hc : c = none
    · subst c
      exact Or.inl ⟨rfl, cancel h⟩
    by_cases hd : d = none
    · subst d
      exact Or.inr ⟨rfl, cancel (h.trans (mul_comm _ _))⟩
    obtain ⟨c', rfl⟩ := Option.ne_none_iff_exists'.mp hc
    obtain ⟨d', rfl⟩ := Option.ne_none_iff_exists'.mp hd
    have hn := congrArg natDegree h
    have hdegree : (line b).natDegree = 2 := by
      rw [natDegree_mul (line_monic (some c')).ne_zero (line_monic (some d')).ne_zero,
        line_degree_some, line_degree_some] at hn
      simpa only [line, one_mul] using hn
    have := line_degree b
    omega
  | some a =>
    have root_line (i : Option F) : (line i).eval (-a) = 0 ↔ i = some a := by
      cases i <;> simp [line, add_comm, add_neg_eq_zero]
    have he := congrArg (eval (-a)) h
    simp only [eval_mul, (root_line _).mpr rfl, zero_mul] at he
    rcases mul_eq_zero.mp he.symm with hc | hd
    · have e := (root_line c).mp hc
      subst c
      exact Or.inl ⟨rfl, cancel h⟩
    · have e := (root_line d).mp hd
      subst d
      exact Or.inr ⟨rfl, cancel (h.trans (mul_comm _ _))⟩

def lineUnit (i : Option F) : Kˣ :=
  Units.mk0 (AdjoinRoot.mk cubic (line i)) (fun h => by
    have hz : line i = 0 := mk_low_injective ((line_degree i).trans (by decide)) (by simp) (by simpa using h)
    exact (line_monic i).ne_zero hz)

def baseMap : Fˣ →* Kˣ := Units.map (algebraMap F K).toMonoidHom

def scalars : Subgroup Kˣ := baseMap.range

abbrev Q := Kˣ ⧸ scalars

def proj : Kˣ →* Q := QuotientGroup.mk' scalars

def label (i : Option F) : Q := proj (lineUnit i)

theorem class_eq_iff_scalar (a b : Kˣ) :
    proj a = proj b ↔ ∃ u : Fˣ, (a : K) = algebraMap F K (u : F) * (b : K) := by
  rw [show proj a = proj b ↔ a / b ∈ scalars from QuotientGroup.eq_iff_div_mem]
  constructor
  · rintro ⟨u, hu⟩
    refine ⟨u, (div_eq_iff (Units.ne_zero b)).mp ?_⟩
    simpa [baseMap] using (congrArg Units.val hu).symm
  · rintro ⟨u, hu⟩
    refine ⟨u, Units.ext ?_⟩
    simpa [baseMap] using ((div_eq_iff (Units.ne_zero b)).mpr hu).symm

theorem label_product_unique (a b c d : Option F)
    (h : label a * label b = label c * label d) :
    (a = c ∧ b = d) ∨ (a = d ∧ b = c) := by
  have hp : proj (lineUnit a * lineUnit b) = proj (lineUnit c * lineUnit d) := by
    simpa only [map_mul, label] using h
  obtain ⟨u, hu⟩ := (class_eq_iff_scalar _ _).mp hp
  have deg (i j : Option F) : (line i * line j).natDegree ≤ 2 :=
    natDegree_mul_le_of_le (line_degree i) (line_degree j)
  have he : line a * line b = C (u : F) * (line c * line d) :=
    mk_low_injective (deg _ _) ((natDegree_C_mul_le _ _).trans (deg _ _))
      (by simpa [lineUnit, AdjoinRoot.algebraMap_eq] using hu)
  have hm := congrArg leadingCoeff he
  simp only [leadingCoeff_mul, (line_monic _).leadingCoeff, leadingCoeff_C, mul_one] at hm
  apply line_product_unique
  simpa [← hm] using he

theorem label_injective : Function.Injective label := by
  intro a b h
  have ht : label a * label none = label b * label none := by rw [h]
  rcases label_product_unique a none b none ht with h' | h'
  · exact h'.1
  · exact h'.1.trans h'.2

theorem card_quotient : Nat.card Q = v := by
  let : Module.Finite F K := cubic_monic.finite_adjoinRoot
  have hK : Nat.card K = q ^ 3 := by
    rw [Module.natCard_eq_pow_finrank (K := F), Nat.card_zmod,
      (AdjoinRoot.powerBasis' cubic_monic).finrank]
    exact congrArg (q ^ ·) cubic_degree
  have hsc : Nat.card scalars = q - 1 := by
    have hmap := Units.map_injective (algebraMap F K).injective
    unfold scalars baseMap
    rw [← Nat.card_congr (MonoidHom.ofInjective hmap).toEquiv, Nat.card_units, Nat.card_zmod]
  apply Nat.eq_of_mul_eq_mul_right (by decide : 0 < q - 1)
  calc
    Nat.card Q * (q - 1) = Nat.card Kˣ := by
      rw [← hsc]
      exact scalars.index_mul_card
    _ = q ^ 3 - 1 := by rw [Nat.card_units, hK]
    _ = v * (q - 1) := by decide

def θ : K := AdjoinRoot.root cubic

def generator : Q := label (some 0)

theorem generator_order : orderOf generator = v := by
  have hne : generator ≠ 1 := by
    intro h
    have hnone : label none = 1 := by simp [label, lineUnit, line]
    have := label_injective (h.trans hnone.symm)
    contradiction
  have hd := orderOf_dvd_natCard generator
  rw [card_quotient] at hd
  exact (v_prime.eq_one_or_self_of_dvd _ hd).resolve_left (orderOf_eq_one_iff.not.mpr hne)

def intExponent : ℤ →+ Additive Q where
  toFun n := Additive.ofMul (generator ^ n)
  map_zero' := by simp
  map_add' a b := by simp [zpow_add]

def exponent : ZMod v →+ Additive Q :=
  ZMod.lift (A := Additive Q) v ⟨intExponent, by
    change Additive.ofMul (generator ^ (v : ℤ)) = 0
    rw [zpow_natCast, ← generator_order, pow_orderOf_eq_one]
    rfl⟩

theorem exponent_pow (a : ZMod v) : (exponent a).toMul = generator ^ a.val := by
  calc
    (exponent a).toMul = (exponent ((a.val : ℤ) : ZMod v)).toMul := by simp
    _ = _ := by
      unfold exponent
      rw [ZMod.lift_coe]
      change generator ^ (a.val : ℤ) = generator ^ a.val
      rw [zpow_natCast]

theorem exponent_bijective : Function.Bijective exponent := by
  let : Finite Q := (Nat.card_pos_iff.mp (card_quotient ▸ Nat.ne_zero_iff_zero_lt.mp (by decide : v ≠ 0))).2
  apply (Nat.bijective_iff_injective_and_card _).mpr
  refine ⟨?_, by rw [Nat.card_zmod]; exact card_quotient.symm⟩
  intro a b h
  have he := congrArg Additive.toMul h
  rw [exponent_pow, exponent_pow] at he
  have hm := (pow_inj_mod (x := generator)).mp he
  rw [generator_order, Nat.mod_eq_of_lt a.val_lt, Nat.mod_eq_of_lt b.val_lt] at hm
  exact ZMod.val_injective v hm

theorem root_cubic : θ ^ 3 = θ + 2 := by
  have h : AdjoinRoot.mk cubic (X ^ 3 - X - 2) = 0 := AdjoinRoot.mk_self
  rw [map_sub, map_sub, map_pow, AdjoinRoot.mk_X, map_ofNat] at h
  change θ ^ 3 - θ - 2 = 0 at h
  linear_combination h

theorem rootUnit_val : ((lineUnit (some 0) : Kˣ) : K) = θ := by
  simp [lineUnit, line, θ]

def coeffPoly (a : Greedy.Coefficients) : F[X] :=
  C (a.1 : F) + C (a.2.1 : F) * X + C (a.2.2 : F) * X ^ 2

theorem coeffPoly_degree (a : Greedy.Coefficients) : (coeffPoly a).natDegree ≤ 2 := by
  have h1 : (C (a.1 : F) + C (a.2.1 : F) * X).natDegree ≤ 2 := by
    exact (natDegree_add_le_of_le
      (show (C (a.1 : F)).natDegree ≤ 0 by simp)
      (show (C (a.2.1 : F) * X).natDegree ≤ 1 from (natDegree_C_mul_le ..).trans (by simp))).trans
      (by decide)
  have h2 : (C (a.2.2 : F) * X ^ 2).natDegree ≤ 2 :=
    (natDegree_C_mul_le ..).trans (by simp)
  simpa only [coeffPoly, max_self] using natDegree_add_le_of_le h1 h2

theorem coeffPoly_last (a : Greedy.Coefficients) : (coeffPoly a).coeff 2 = (a.2.2 : F) := by
  simp [coeffPoly, coeff_X_pow]

theorem coeffPoly_eval (a : ZMod v) :
    AdjoinRoot.mk cubic (coeffPoly (Greedy.powerX Greedy.full a.val)) =
      ((lineUnit (some 0) ^ a.val : Kˣ) : K) := by
  rw [Units.val_pow_eq_pow_val, rootUnit_val, ← evalPower θ root_cubic a.val]
  simp [coeffPoly, evalCoeffs, θ, AdjoinRoot.algebraMap_eq]

theorem powerAux_last_lt (fuel n : ℕ) : (Greedy.powerAux Greedy.full fuel n).2.2 < q := by
  have hmul (a b : Greedy.Coefficients) : (Greedy.multiply Greedy.full a b).2.2 < q := by
    rcases a with ⟨a0, a1, a2⟩
    rcases b with ⟨b0, b1, b2⟩
    exact Nat.mod_lt _ q_prime.pos
  cases fuel with
  | zero => exact q_prime.pos
  | succ fuel =>
    simp only [Greedy.powerAux]
    split
    · exact q_prime.pos
    · split <;> apply hmul

end

/-- The actual eligible columns enumerated by the colouring algorithm. -/
def columns : Finset (ZMod v) :=
  Finset.univ.filter fun a => Greedy.eligible Greedy.full a.val

noncomputable section

theorem mem_columns_iff (a : ZMod v) :
    a ∈ columns ↔ ∃ i, (exponent a).toMul = label i := by
  let coeffs := Greedy.powerX Greedy.full a.val
  have hp : proj (lineUnit (some 0) ^ a.val) = (exponent a).toMul := by
    rw [exponent_pow, map_pow]
    rfl
  have he := coeffPoly_eval a
  change AdjoinRoot.mk cubic (coeffPoly coeffs) = ((lineUnit (some 0) ^ a.val : Kˣ) : K) at he
  constructor
  · intro h
    have hc : coeffs.2.2 = 0 := by simpa [columns, Greedy.eligible, coeffs] using h
    have polynomial : coeffPoly coeffs = C (coeffs.1 : F) + C (coeffs.2.1 : F) * X := by
      simp [coeffPoly, hc]
    by_cases hb : (coeffs.2.1 : F) = 0
    · have ha : (coeffs.1 : F) ≠ 0 := by
        intro ha
        simp [polynomial, ha, hb] at he
        exact pow_ne_zero _ (Units.ne_zero (lineUnit (some 0))) he.symm
      refine ⟨none, hp ▸ (class_eq_iff_scalar _ _).mpr ⟨Units.mk0 _ ha, ?_⟩⟩
      rw [← he]
      simp [polynomial, hb, lineUnit, line, AdjoinRoot.algebraMap_eq]
    · let t : F := (coeffs.1 : F) / (coeffs.2.1 : F)
      have ht : (coeffs.2.1 : F) * t = (coeffs.1 : F) := by
        dsimp [t]
        field_simp
      have heq : coeffPoly coeffs = C (coeffs.2.1 : F) * line (some t) := by
        rw [polynomial, line, mul_add, ← C_mul, ht, add_comm]
      refine ⟨some t, hp ▸ (class_eq_iff_scalar _ _).mpr ⟨Units.mk0 _ hb, ?_⟩⟩
      rw [← he]
      simp [heq, lineUnit, AdjoinRoot.algebraMap_eq]
  · rintro ⟨i, hx⟩
    have hpr : proj (lineUnit (some 0) ^ a.val) = proj (lineUnit i) := hp.trans hx
    obtain ⟨u, hu⟩ := (class_eq_iff_scalar _ _).mp hpr
    have hpoly : coeffPoly coeffs = C (u : F) * line i :=
      mk_low_injective (coeffPoly_degree _) ((natDegree_C_mul_le ..).trans ((line_degree _).trans (by decide)))
        (by rw [he]; simpa [lineUnit, AdjoinRoot.algebraMap_eq] using hu)
    have hz : (coeffs.2.2 : F) = 0 := by
      rw [← coeffPoly_last, hpoly]
      apply coeff_eq_zero_of_natDegree_lt
      exact ((natDegree_C_mul_le ..).trans (line_degree _)).trans_lt (by decide)
    have hc : coeffs.2.2 = 0 := by
      have h' := congrArg ZMod.val hz
      simpa [ZMod.val_natCast_of_lt (powerAux_last_lt a.val a.val), coeffs, Greedy.powerX] using h'
    simpa [columns, Greedy.eligible, coeffs] using hc

theorem columns_card : columns.card = q + 1 := by
  let e := Equiv.ofBijective exponent exponent_bijective
  let f (i : Option F) := e.symm (Additive.ofMul (label i))
  have image : columns = Finset.univ.image f := by
    ext a
    rw [mem_columns_iff]
    simp only [Finset.mem_image, Finset.mem_univ, true_and]
    apply exists_congr
    intro i
    change (e a).toMul = label i ↔ e.symm (Additive.ofMul (label i)) = a
    rw [Equiv.symm_apply_eq]
    exact ⟨fun h => (congrArg Additive.ofMul h).symm, fun h => (congrArg Additive.toMul h).symm⟩
  have hinj : Function.Injective f := e.symm.injective.comp (Additive.ofMul.injective.comp label_injective)
  rw [image, Finset.card_image_of_injective _ hinj]
  simp [ZMod.card]

theorem columns_uniqueDifferences : UniqueDifferences columns := by
  intro x hx y hy z hz u hu hne hd
  obtain ⟨a, ha⟩ := (mem_columns_iff x).mp hx
  obtain ⟨b, hb⟩ := (mem_columns_iff y).mp hy
  obtain ⟨c, hc⟩ := (mem_columns_iff z).mp hz
  obtain ⟨d, hdd⟩ := (mem_columns_iff u).mp hu
  have had : label a * label d = label c * label b := by
    have hsum : x + u = z + y := sub_eq_sub_iff_add_eq_add.mp hd
    have hh := congrArg exponent hsum
    rw [map_add, map_add] at hh
    have he := congrArg Additive.toMul hh
    change (exponent x).toMul * (exponent u).toMul = (exponent z).toMul * (exponent y).toMul at he
    rwa [ha, hb, hc, hdd] at he
  rcases label_product_unique a d c b had with ⟨hac, hdb⟩ | ⟨hab, _⟩
  · subst c
    subst d
    exact ⟨exponent_bijective.injective (Additive.toMul.injective (ha.trans hc.symm)),
      exponent_bijective.injective (Additive.toMul.injective (hb.trans hdd.symm))⟩
  · subst b
    exact (hne (exponent_bijective.injective (Additive.toMul.injective (ha.trans hb.symm)))).elim

end

end Green14.Singer

set_option maxRecDepth 4096

namespace Green14

open Finset

def window : ℕ := 100000000000000000000
def tailLimit : ℕ := 20000000000
def deviation : ℕ := 100000000000

def point (a d : ZMod v) (j : ℕ) : ZMod v := a + (j : ZMod v) * d

theorem point_injective_below (a d : ZMod v) (hd : d ≠ 0) {i j : ℕ}
    (hi : i < v) (hj : j < v) (h : point a d i = point a d j) : i = j := by
  let : Fact v.Prime := ⟨v_prime⟩
  have he : (i : ZMod v) = j := mul_right_cancel₀ hd (add_left_cancel h)
  simpa only [ZMod.val_natCast_of_lt hi, ZMod.val_natCast_of_lt hj] using congrArg ZMod.val he

def tail (C : Finset (ZMod v)) (a d : ZMod v) : Finset ℕ :=
  (Ico r (r + window)).filter fun j => point a d j ∈ C

theorem tail_card_bound (C : Finset (ZMod v)) (hs : UniqueDifferences C)
    (a d : ZMod v) (hd : d ≠ 0) :
    (tail C a d).card ≤ tailLimit := by
  let T := tail C a d
  let f (p : ℕ × ℕ) : ℤ := (p.1 : ℤ) - p.2
  have bound : r + window < v := by decide
  have hb : T.offDiag.card ≤ (Ioo (-(window : ℤ)) (window : ℤ)).card := by
    apply Finset.card_le_card_of_injOn f
    · intro p hp
      have hp' := Finset.mem_offDiag.mp hp
      have h1 := Finset.mem_Ico.mp (Finset.mem_filter.mp hp'.1).1
      have h2 := Finset.mem_Ico.mp (Finset.mem_filter.mp hp'.2.1).1
      exact Finset.mem_Ioo.mpr (by dsimp [f]; omega)
    · intro p hp t ht e
      have hp' := Finset.mem_offDiag.mp hp
      have ht' := Finset.mem_offDiag.mp ht
      obtain ⟨hpi, hpc⟩ := Finset.mem_filter.mp hp'.1
      obtain ⟨hpj, hpd⟩ := Finset.mem_filter.mp hp'.2.1
      obtain ⟨hti, htc⟩ := Finset.mem_filter.mp ht'.1
      obtain ⟨htj, htd⟩ := Finset.mem_filter.mp ht'.2.1
      have vp1 := (Finset.mem_Ico.mp hpi).2.trans bound
      have vp2 := (Finset.mem_Ico.mp hpj).2.trans bound
      have vt1 := (Finset.mem_Ico.mp hti).2.trans bound
      have vt2 := (Finset.mem_Ico.mp htj).2.trans bound
      have e' := congrArg (fun i : ℤ => (i : ZMod v)) e
      simp only [f, Int.cast_sub, Int.cast_natCast] at e'
      have ed : point a d p.1 - point a d p.2 = point a d t.1 - point a d t.2 := by
        unfold point
        linear_combination d * e'
      have en : point a d p.1 ≠ point a d p.2 :=
        fun h => hp'.2.2 (point_injective_below _ _ hd vp1 vp2 h)
      obtain ⟨ei, ej⟩ := hs _ hpc _ hpd _ htc _ htd en ed
      exact Prod.ext (point_injective_below _ _ hd vp1 vt1 ei)
        (point_injective_below _ _ hd vp2 vt2 ej)
  rw [Finset.offDiag_card, Int.card_Ioo] at hb
  change T.card ≤ tailLimit
  by_contra! h
  have hm : tailLimit * (tailLimit - 1) ≤ T.card * (T.card - 1) :=
    Nat.mul_le_mul h.le (Nat.sub_le_sub_right h.le 1)
  exact (by decide : ¬tailLimit * (tailLimit - 1) ≤
    ((window : ℤ) - -(window : ℤ) - 1).toNat)
      (hm.trans (by simpa only [Nat.mul_sub_left_distrib, Nat.mul_one] using hb))

def firstHits (C : Finset (ZMod v)) (a d : ZMod v) : Finset ℕ :=
  (range r).filter fun j => point a d j ∈ C

/-- The overlap variance and short-tail Sidon bound give a uniform hit count. -/
theorem hit_count (C : Finset (ZMod v)) (hc : C.card = q + 1)
    (hu : UniqueDifferences C) (a d : ZMod v) (hd : d ≠ 0) :
    hitFloor ≤ (firstHits C a d).card := by
  classical
  let S := (range r).image (point 0 d)
  have hr : r < v := numerical_bounds.2.1
  have hS : S.card = r := by
    rw [(Finset.card_image_iff.mpr (fun _ hi _ hj h =>
      point_injective_below _ _ hd ((Finset.mem_range.mp hi).trans hr)
        ((Finset.mem_range.mp hj).trans hr) h)), Finset.card_range]
  let μ : ℝ := (r : ℝ) * ((q + 1 : ℕ) : ℝ) / (v : ℝ)
  have hμ : (hitFloor : ℝ) + tailLimit + deviation ≤ μ := by
    norm_num [μ, hitFloor, tailLimit, deviation, r, v, q]
  let tests := (range window).image (point a d)
  have htests : tests.card = window := by
    have hlen : window < v := by decide
    rw [(Finset.card_image_iff.mpr (fun _ hi _ hj h =>
      point_injective_below _ _ hd ((Finset.mem_range.mp hi).trans hlen)
        ((Finset.mem_range.mp hj).trans hlen) h)), Finset.card_range]
  by_contra! hl
  have le_test (t : ℕ) (ht : t < window) :
      overlap C S (point a d t) ≤ (hitFloor : ℝ) + tailLimit := by
    let R := ((range r).image (t + ·)).filter fun j => point a d j ∈ C
    have hR : overlap C S (point a d t) = R.card := by
      unfold overlap
      dsimp only [S, R]
      rw [Finset.sum_image (fun _ hi _ hj h =>
        point_injective_below _ _ hd ((Finset.mem_range.mp hi).trans hr)
          ((Finset.mem_range.mp hj).trans hr) h)]
      have had (j : ℕ) : point a d t + point 0 d j = point a d (t + j) := by
        simp only [point, zero_add, Nat.cast_add]
        ring
      simp only [had, bit, ← Finset.sum_boole]
      rw [Finset.sum_image (fun _ _ _ _ h => Nat.add_left_cancel h)]
    have hsubset : R ⊆ firstHits C a d ∪ tail C a d := by
      intro j hj
      obtain ⟨hidx, hjC⟩ := Finset.mem_filter.mp hj
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hidx
      have hi' := Finset.mem_range.mp hi
      by_cases h : t + i < r
      · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨Finset.mem_range.mpr h, hjC⟩)
      · exact Finset.mem_union_right _ (Finset.mem_filter.mpr
          ⟨Finset.mem_Ico.mpr (by omega), hjC⟩)
    rw [hR]
    have hcard := (Finset.card_le_card hsubset).trans (Finset.card_union_le _ _)
    exact_mod_cast hcard.trans (Nat.add_le_add hl.le (tail_card_bound C hu a d hd))
  have lower : (window : ℝ) * (deviation : ℝ) ^ 2 ≤
      ∑ g : ZMod v, (overlap C S g - μ) ^ 2 := calc
    _ = ∑ _g ∈ tests, (deviation : ℝ) ^ 2 := by simp [htests]
    _ ≤ ∑ g ∈ tests, (overlap C S g - μ) ^ 2 := by
      apply Finset.sum_le_sum
      intro g hg
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hg
      have he := le_test j (Finset.mem_range.mp hj)
      have hdv : 0 ≤ (deviation : ℝ) := Nat.cast_nonneg _
      have hmul := mul_nonneg (show 0 ≤ μ - overlap C S (point a d j) - deviation by linarith)
        (show 0 ≤ μ - overlap C S (point a d j) + deviation by linarith)
      nlinarith only [hmul]
    _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) (by
      intro i _ _
      exact sq_nonneg _)
  have upper := overlap_variance C S hu
  dsimp only at upper
  rw [hS, hc, ZMod.card] at upper
  have numeric :
      (r : ℝ) * ((((q + 1 : ℕ) : ℝ)) + r - 1) - v * μ ^ 2 <
        (window : ℝ) * (deviation : ℝ) ^ 2 := by
    norm_num [μ, q, v, r, window, deviation]
  exact (not_lt_of_ge (lower.trans upper)) numeric

end Green14

namespace Green14.Greedy

open Finset

attribute [local irreducible] candidates bestStep run progressions

theorem used_iff {s : Shifts} {a : ℕ} :
    used s a = true ↔ ∃ b ∈ s, (b : ℕ × ℕ).1 = a := by
  simp [used]

theorem mem_candidates {s : Shifts} {b : ℕ × ℕ} :
    b ∈ candidates full s ↔ b.1 < v ∧ eligible full b.1 = true ∧
      used s b.1 = false ∧ b.2 < w := by
  rcases b with ⟨a, shift⟩
  simp only [candidates, List.mem_flatMap, List.mem_range]
  constructor
  · rintro ⟨i, hi, hs⟩
    split at hs
    · rename_i h
      obtain ⟨j, hj, hji⟩ := List.mem_map.mp hs
      obtain ⟨rfl, rfl⟩ := Prod.mk.inj hji
      have he := Bool.and_eq_true_iff.mp h
      exact ⟨hi, he.1, Bool.eq_false_of_not_eq_true' he.2, List.mem_range.mp hj⟩
    · simp at hs
  · rintro ⟨ha, he, hu, hw⟩
    exact ⟨a, ha, by simpa [he, hu] using (show shift < full.w from hw)⟩

theorem best_mem {inst : Instance} {s : Shifts} {b : ℕ × ℕ} (h : bestStep inst s = some b) :
    b ∈ candidates inst s := by
  unfold bestStep at h
  exact List.argmax_mem (by simpa only [Option.mem_def] using Option.eq_some_of_filter_eq_some h)

theorem argmax_positive {α : Type*} (ls : List α) (rating : α → ℕ)
    {b : α} (hb : b ∈ ls) (positive : 0 < rating b) :
    ∃ chosen, (ls.argmax rating).filter (fun c => decide (0 < rating c)) = some chosen ∧
      ∀ c ∈ ls, rating c ≤ rating chosen := by
  cases h : ls.argmax rating with
  | none => simp [List.argmax_eq_none.mp h] at hb
  | some chosen =>
    have hmem : chosen ∈ ls.argmax rating := by rw [Option.mem_def]; exact h
    have hm : ∀ c ∈ ls, rating c ≤ rating chosen :=
      fun _ hc => List.le_of_mem_argmax hc hmem
    have hp : 0 < rating chosen := positive.trans_le (hm _ hb)
    exact ⟨chosen, Option.filter_some_pos (decide_eq_true hp), hm⟩

theorem exists_best {inst : Instance} {s : Shifts} {b : ℕ × ℕ} (hb : b ∈ candidates inst s)
    (positive : 0 < score inst (live inst s) b.1 b.2) :
    ∃ chosen, bestStep inst s = some chosen ∧
      ∀ c ∈ candidates inst s, score inst (live inst s) c.1 c.2 ≤
        score inst (live inst s) chosen.1 chosen.2 := by
  obtain ⟨c, hc, hm⟩ := @argmax_positive (ℕ × ℕ) (candidates inst s)
    (fun c => score inst (live inst s) c.1 c.2) b hb positive
  refine ⟨c, ?_, hm⟩
  unfold bestStep
  exact hc

theorem run_succ_end (s : Shifts) (n : ℕ) {inst : Instance} :
    run inst (n + 1) s = advance inst (run inst n s) := by
  induction n generalizing s with
  | zero =>
    cases h : bestStep inst s <;> simp [run, advance, h]
  | succ n ih =>
    cases h : bestStep inst s with
    | none => simp only [run, h, advance]
    | some b => simpa only [run, h] using ih (s ++ [b])

theorem mem_fields {inst : Instance} {p : Progression} {n : ℕ} :
    n ∈ fields inst p ↔ ∃ j < inst.r, p.1 + j * p.2 = n := by
  simp only [fields, List.mem_map, List.mem_range]

theorem mem_progressions_of_pos {inst : Instance} (hr : 0 < inst.r - 1) {p : Progression} :
    p ∈ progressions inst ↔ 1 ≤ p.1 ∧ 0 < p.2 ∧ p.1 + (inst.r - 1) * p.2 ≤ inst.n := by
  rcases p with ⟨a, d⟩
  unfold progressions
  simp only [List.mem_flatMap, List.mem_range, List.mem_map, Prod.mk.injEq]
  constructor
  · rintro ⟨k, _, j, hj, rfl, rfl⟩
    exact ⟨by omega, by omega, by omega⟩
  · rintro ⟨ha, hd, hlast⟩
    have hk : d ≤ (inst.n - 1) / (inst.r - 1) := by
      refine (Nat.le_div_iff_mul_le hr).mpr ?_
      rw [Nat.mul_comm]
      omega
    refine ⟨d - 1, by omega, a - 1, ?_, by omega, by omega⟩
    rw [show d - 1 + 1 = d by omega]
    omega

theorem mem_progressions {p : Progression} :
    p ∈ progressions full ↔ 1 ≤ p.1 ∧ 0 < p.2 ∧ p.1 + (r - 1) * p.2 ≤ N :=
  mem_progressions_of_pos (inst := full) (by decide)

theorem progressions_nodup {inst : Instance} : (progressions inst).Nodup := by
  unfold progressions
  rw [List.nodup_flatMap]
  refine ⟨fun k _ => List.nodup_range.map (fun _ _ e => by
    have := congrArg Prod.fst e
    omega), ?_⟩
  refine List.Pairwise.imp ?_ List.nodup_range
  intro a b h
  apply List.disjoint_left.mpr
  intro p h₁ h₂
  obtain ⟨_, _, rfl⟩ := List.mem_map.mp h₁
  obtain ⟨_, _, he⟩ := List.mem_map.mp h₂
  exact h (by have := congrArg Prod.snd he; omega)

theorem mem_live {inst : Instance} {s : Shifts} {p : Progression} :
    p ∈ live inst s ↔ p ∈ progressions inst ∧
      ∀ n ∈ fields inst p, isRed inst s n = false := by
  simp [live, Bool.not_eq_true]

def hitsPairFor (inst : Instance) (b : ℕ × ℕ) (p : Progression) : Bool :=
  (fields inst p).any fun n => n % inst.v == b.1 && inTranslation inst (n / inst.v) b.2

abbrev hitsPair := hitsPairFor full

theorem score_card {inst : Instance} (s : Shifts) (b : ℕ × ℕ) :
    score inst (live inst s) b.1 b.2 =
      ((live inst s).toFinset.filter (fun p => hitsPairFor inst b p)).card := by
  rw [← List.toFinset_filter, List.toFinset_card_of_nodup]
  · rfl
  · exact (progressions_nodup.filter _).filter _

theorem old_red {inst : Instance} {s : Shifts} {b : ℕ × ℕ} {n : ℕ} (h : isRed inst s n = true) :
    isRed inst (s ++ [b]) n = true := by
  unfold isRed at h ⊢
  rw [List.find?_append]
  split at h <;> rename_i hf
  · contradiction
  · simpa [hf] using h

theorem new_red {inst : Instance} {s : Shifts} {b : ℕ × ℕ} {n : ℕ}
    (unused : used s b.1 = false) (ha : n % inst.v = b.1)
    (hr : inTranslation inst (n / inst.v) b.2 = true) :
    isRed inst (s ++ [b]) n = true := by
  have hnone : s.find? (fun p => p.1 == n % inst.v) = none := by
    rw [List.find?_eq_none]
    intro p hp e
    have hused : used s b.1 = true := used_iff.mpr ⟨p, hp, (beq_iff_eq.mp e).trans ha⟩
    simp [unused] at hused
  rw [ha] at hnone
  simpa [isRed, ha, hnone] using hr

theorem allowed_spec (m z : ℕ) :
    allowedDigits m z = true ↔ BinaryTernary m z := by
  induction m generalizing z with
  | zero => simp [allowedDigits, BinaryTernary]
  | succ m ih => simp [allowedDigits, BinaryTernary, ih]

theorem translated_val (b shift : ℕ) (hs : shift < w) :
    ((b % w + w - shift) % w) = ((b : ZMod w) - (shift : ZMod w)).val := by
  have he : (((b % w + w - shift) % w : ℕ) : ZMod w) =
      (b : ZMod w) - (shift : ZMod w) := by
    rw [ZMod.natCast_mod, Nat.cast_sub (by omega : shift ≤ b % w + w), Nat.cast_add,
      ZMod.natCast_self, add_zero, ZMod.natCast_mod]
  simpa only [ZMod.val_natCast_of_lt (Nat.mod_lt _ (by decide : 0 < w))] using
    congrArg ZMod.val he

theorem translation_spec (b shift : ℕ) (hs : shift < w) :
    inTranslation full b shift = true ↔ BinaryTernary 56
      ((b : ZMod w) - (shift : ZMod w)).val := by
  change allowedDigits 56 ((b % w + w - shift) % w) = true ↔ _
  rw [translated_val _ _ hs, allowed_spec]

/-- Read a binary numeral as ternary, preserving digits. -/
def encode : ℕ → ℕ → ℕ
  | 0, _ => 0
  | m + 1, n => n % 2 + 3 * encode m (n / 2)

theorem encode_lt (m n : ℕ) : encode m n < 3 ^ m := by
  induction m generalizing n with
  | zero => simp [encode]
  | succ m ih =>
    rw [encode, pow_succ]
    have := ih (n / 2)
    omega

theorem encode_digits (m n : ℕ) : BinaryTernary m (encode m n) := by
  induction m generalizing n with
  | zero => rfl
  | succ m ih =>
    rw [encode, BinaryTernary]
    constructor
    · omega
    · have h : (n % 2 + 3 * encode m (n / 2)) / 3 = encode m (n / 2) := by omega
      rw [h]
      exact ih _

theorem encode_inj (m i j : ℕ) (hi : i < 2 ^ m) (hj : j < 2 ^ m)
    (h : encode m i = encode m j) : i = j := by
  induction m generalizing i j with
  | zero => simp at hi hj; omega
  | succ m ih =>
    rw [encode, encode] at h
    rw [pow_succ] at hi hj
    have he : i / 2 = j / 2 := ih _ _ (by omega) (by omega) (by omega)
    omega

def shiftFor (b i : ℕ) : ℕ := ((b : ZMod w) - (encode 56 i : ZMod w)).val

theorem shiftFor_lt (b i : ℕ) : shiftFor b i < w := ZMod.val_lt _

theorem shiftFor_hits (b i : ℕ) : inTranslation full b (shiftFor b i) = true := by
  apply (translation_spec _ _ (shiftFor_lt ..)).mpr
  unfold shiftFor
  rw [ZMod.natCast_zmod_val, sub_sub_cancel,
    ZMod.val_natCast_of_lt (show encode 56 i < w from encode_lt ..)]
  exact encode_digits ..

theorem shiftFor_inj (b i j : ℕ) (hi : i < 2 ^ 56) (hj : j < 2 ^ 56)
    (h : shiftFor b i = shiftFor b j) : i = j := by
  have e := ZMod.val_injective w h
  have e' : (encode 56 i : ZMod w) = (encode 56 j : ZMod w) := sub_right_injective e
  apply encode_inj 56 i j hi hj
  have hv := congrArg ZMod.val e'
  rw [ZMod.val_natCast_of_lt (show encode 56 i < w from encode_lt 56 i),
    ZMod.val_natCast_of_lt (show encode 56 j < w from encode_lt 56 j)] at hv
  exact hv

end Green14.Greedy

namespace Green14.Greedy

open Finset

set_option maxRecDepth 4096

attribute [local irreducible] candidates bestStep run progressions live

theorem mem_eligible {a : ZMod v} :
    a ∈ Singer.columns ↔ eligible full a.val = true := by
  simp [Singer.columns]

theorem mem_hit {a d : ZMod v} {j : ℕ} :
    j ∈ firstHits Singer.columns a d ↔ j < r ∧ point a d j ∈ Singer.columns := by
  simp [firstHits]

attribute [local irreducible] Singer.columns firstHits

def coord (p : Progression) (j : ℕ) : ℕ := (p.1 + j * p.2) % v

theorem diff_lt_of_end {a d : ℕ} (ha : 1 ≤ a) (hl : a + (r - 1) * d ≤ N) : d < v := by
  have hd : d ≤ (N - 1) / (r - 1) := by
    refine (Nat.le_div_iff_mul_le (by decide : 0 < r - 1)).mpr ?_
    rw [Nat.mul_comm]
    omega
  rw [numerical_bounds.2.2.1] at hd
  have hpos : 0 < v := by decide
  omega

theorem diff_lt {p : Progression} (hp : p ∈ progressions full) : p.2 < v :=
  diff_lt_of_end ((mem_progressions (p := p)).mp hp).1 ((mem_progressions (p := p)).mp hp).2.2

theorem diff_nonzero {p : Progression} (hp : p ∈ progressions full) :
    (p.2 : ZMod v) ≠ 0 := by
  intro h
  have he := congrArg ZMod.val h
  rw [ZMod.val_natCast_of_lt (diff_lt hp), ZMod.val_zero] at he
  exact (Nat.ne_of_gt (mem_progressions.mp hp).2.1) he

theorem point_val (p : Progression) (j : ℕ) :
    (point (p.1 : ZMod v) (p.2 : ZMod v) j).val = coord p j := by
  unfold coord
  rw [← ZMod.val_natCast v (p.1 + j * p.2)]
  simp only [point, Nat.cast_add, Nat.cast_mul]

theorem coord_inj {p : Progression} (hp : p ∈ progressions full)
    {i j : ℕ} (hi : i < r) (hj : j < r) (h : coord p i = coord p j) : i = j := by
  apply point_injective_below (p.1 : ZMod v) _ (diff_nonzero hp)
    (hi.trans numerical_bounds.2.1) (hj.trans numerical_bounds.2.1)
  apply ZMod.val_injective v
  simpa only [point_val] using h

def choices (s : Shifts) : Finset (ℕ × ℕ) := (candidates full s).toFinset

theorem choices_card_aux (s : Shifts) (width : ℕ) (hw : w ≤ width) :
    (choices s).card ≤ (q + 1) * width := by
  let colNums := Singer.columns.image ZMod.val
  have hcard : colNums.card = q + 1 := by
    rw [Finset.card_image_of_injective _ (ZMod.val_injective v), Singer.columns_card]
  have hsubset : choices s ⊆ colNums ×ˢ range width := by
    intro b hb
    have ⟨ha, he, _, hs⟩ := (mem_candidates (s := s) (b := b)).mp (List.mem_toFinset.mp hb)
    apply (Finset.mem_product (s := colNums) (t := range width) (p := b)).mpr
    refine ⟨Finset.mem_image.mpr ⟨(b.1 : ZMod v), ?_, ZMod.val_natCast_of_lt ha⟩,
      Finset.mem_range.mpr (hs.trans_le hw)⟩
    exact mem_eligible.mpr (by rwa [ZMod.val_natCast_of_lt ha])
  exact (Finset.card_le_card hsubset).trans (by
    rw [Finset.card_product colNums (range width), Finset.card_range, hcard])

theorem choices_card (s : Shifts) : (choices s).card ≤ (q + 1) * w :=
  choices_card_aux s w le_rfl

def seenHits (s : Shifts) (p : Progression) : Finset ℕ :=
  (firstHits Singer.columns (p.1 : ZMod v) (p.2 : ZMod v)).filter fun j =>
    used s (coord p j)

def unusedHits (s : Shifts) (p : Progression) : Finset ℕ :=
  (firstHits Singer.columns (p.1 : ZMod v) (p.2 : ZMod v)).filter fun j =>
    used s (coord p j) = false

theorem unusedHits_card (s : Shifts) (p : Progression) (hp : p ∈ progressions full) :
    hitFloor - s.length ≤ (unusedHits s p).card := by
  have hseen : (seenHits s p).card ≤ s.length := by
    refine le_trans (Finset.card_le_card_of_injOn (coord p)
        (s := seenHits s p) (t := (s.map Prod.fst).toFinset) ?_ ?_)
      (by simpa using (s.map Prod.fst).toFinset_card_le)
    · intro j hj
      have hj' := (Finset.mem_filter.mp hj).2
      obtain ⟨b, hb, eb⟩ := used_iff.mp hj'
      exact List.mem_toFinset.mpr (List.mem_map.mpr ⟨b, hb, eb⟩)
    · intro i hi j hj e
      have hi' := (mem_hit.mp (Finset.mem_filter.mp hi).1).1
      have hj' := (mem_hit.mp (Finset.mem_filter.mp hj).1).1
      exact coord_inj hp hi' hj' e
  have hpartition : (seenHits s p).card + (unusedHits s p).card =
      (firstHits Singer.columns (p.1 : ZMod v) (p.2 : ZMod v)).card := by
    simpa [seenHits, unusedHits, Bool.not_eq_true] using
      (firstHits Singer.columns (p.1 : ZMod v) (p.2 : ZMod v)).card_filter_add_card_filter_not
        (fun j => used s (coord p j))
  have hits := hit_count Singer.columns Singer.columns_card Singer.columns_uniqueDifferences
    (p.1 : ZMod v) (p.2 : ZMod v) (diff_nonzero hp)
  omega

theorem unused_hit_spec {s : Shifts} {p : Progression} {j : ℕ} :
    j ∈ unusedHits s p ↔
      (j < r ∧ point (p.1 : ZMod v) (p.2 : ZMod v) j ∈ Singer.columns) ∧
      used s (coord p j) = false := by rw [unusedHits, Finset.mem_filter, mem_hit]

attribute [local irreducible] unusedHits

/-- Each unassigned hit column offers at least \(k\) translations for \(k\le 2^{56}\). -/
theorem many_choices_aux (s : Shifts) (hsize : s.length ≤ steps + 2)
    (p : Progression) (hp : p ∈ progressions full) (k : ℕ) (hk : k ≤ 2 ^ 56) :
    (hitFloor - 2 - steps) * k ≤ ((choices s).filter fun b => hitsPair b p).card := by
  let U := unusedHits s p
  let encodePair (x : ℕ × ℕ) : ℕ × ℕ :=
    (coord p x.1, shiftFor ((p.1 + x.1 * p.2) / v) x.2)
  have hcount : (hitFloor - 2 - steps) * k ≤ (U ×ˢ range k).card := by
    rw [Finset.card_product U (range k), Finset.card_range]
    have hU : hitFloor - s.length ≤ U.card := unusedHits_card s p hp
    exact Nat.mul_le_mul_right _ (by omega)
  refine hcount.trans (Finset.card_le_card_of_injOn encodePair ?_ ?_)
  · intro x hx
    have hU := ((Finset.mem_product (s := U) (t := range k) (p := x)).mp hx).1
    obtain ⟨⟨hjRange, hjC⟩, unused⟩ := unused_hit_spec.mp hU
    have held := mem_eligible.mp hjC
    rw [point_val] at held
    have hshift := shiftFor_lt ((p.1 + x.1 * p.2) / v) x.2
    apply Finset.mem_filter.mpr
    refine ⟨List.mem_toFinset.mpr (mem_candidates.mpr
      ⟨Nat.mod_lt _ (by decide : v > 0), held, unused, hshift⟩), ?_⟩
    exact List.any_eq_true.mpr
      ⟨p.1 + x.1 * p.2, mem_fields.mpr ⟨x.1, hjRange, rfl⟩,
        Bool.and_eq_true_iff.mpr ⟨beq_self_eq_true _, shiftFor_hits _ _⟩⟩
  · intro x hx y hy e
    obtain ⟨hx₁, hx₂⟩ := (Finset.mem_product (s := U) (t := range k) (p := x)).mp hx
    obtain ⟨hy₁, hy₂⟩ := (Finset.mem_product (s := U) (t := range k) (p := y)).mp hy
    have hxi := (unused_hit_spec.mp hx₁).1.1
    have hyi := (unused_hit_spec.mp hy₁).1.1
    have e₁ := coord_inj hp hxi hyi (congrArg Prod.fst e)
    have e₂ := congrArg Prod.snd e
    change shiftFor ((p.1 + x.1 * p.2) / v) x.2 =
      shiftFor ((p.1 + y.1 * p.2) / v) y.2 at e₂
    rw [← e₁] at e₂
    exact Prod.ext e₁ (shiftFor_inj _ _ _ ((Finset.mem_range.mp hx₂).trans_le hk)
      ((Finset.mem_range.mp hy₂).trans_le hk) e₂)

theorem many_choices (s : Shifts) (hsize : s.length ≤ steps + 2)
    (p : Progression) (hp : p ∈ progressions full) :
    incidences ≤ ((choices s).filter fun b => hitsPair b p).card :=
  many_choices_aux s hsize p hp (2 ^ 56) le_rfl

def remainingSet (s : Shifts) : Finset Progression := (live full s).toFinset

def killedSet (s : Shifts) (b : ℕ × ℕ) : Finset Progression :=
  (remainingSet s).filter (fun p => hitsPair b p)

theorem no_new_live (s : Shifts) (b : ℕ × ℕ) :
    remainingSet (s ++ [b]) ⊆ remainingSet s := by
  intro p hp
  have ⟨hprog, hp'⟩ := mem_live.mp (List.mem_toFinset.mp hp)
  refine List.mem_toFinset.mpr (mem_live.mpr ⟨hprog, ?_⟩)
  intro n hn
  apply Bool.eq_false_iff.mpr
  intro h
  have he := old_red (b := b) h
  rw [hp' n hn] at he
  exact Bool.false_ne_true he

theorem remaining_after {s : Shifts} {b : ℕ × ℕ} (hb : b ∈ choices s) :
    remainingSet (s ++ [b]) ⊆ (remainingSet s) \ killedSet s b := by
  intro p hp
  refine Finset.mem_sdiff.mpr ⟨no_new_live s b hp, ?_⟩
  intro hit
  unfold killedSet at hit
  obtain ⟨n, hn, hhit⟩ := List.any_eq_true.mp (Finset.mem_filter.mp hit).2
  have unused := (mem_candidates.mp (List.mem_toFinset.mp hb)).2.2.1
  have he := new_red (inst := full) unused (beq_iff_eq.mp (Bool.and_eq_true_iff.mp hhit).1)
    (Bool.and_eq_true_iff.mp hhit).2
  rw [(mem_live.mp (List.mem_toFinset.mp hp)).2 n hn] at he
  exact Bool.false_ne_true he

theorem remaining_card_mul (s : Shifts) (width height : ℕ)
    (hwidth : N + 1 ≤ width) (hheight : v ≤ height) :
    (remainingSet s).card ≤ width * height := by
  have hsub : remainingSet s ⊆ range width ×ˢ range height := by
    intro p hp
    have hprog := (mem_live.mp (List.mem_toFinset.mp hp)).1
    have he := (mem_progressions.mp hprog).2.2
    exact (Finset.mem_product (s := range width) (t := range height) (p := p)).mpr
      ⟨Finset.mem_range.mpr (by omega), Finset.mem_range.mpr ((diff_lt hprog).trans_le hheight)⟩
  exact (Finset.card_le_card hsub).trans (by rw [Finset.card_product, Finset.card_range, Finset.card_range])

theorem remaining_start (s : Shifts) : (remainingSet s).card ≤ v ^ 3 := by
  calc
    _ ≤ v ^ 2 * v := remaining_card_mul s (v ^ 2) v numerical_bounds.2.2.2.1 le_rfl
    _ = _ := (pow_succ _ _).symm

theorem score_killed (s : Shifts) (b : ℕ × ℕ) :
    score full (live full s) b.1 b.2 = (killedSet s b).card :=
  score_card (inst := full) s b

theorem best_hits_bound (s : Shifts) (hs : s.length ≤ steps + 2)
    (hnon : (remainingSet s).Nonempty) :
    ∃ b, bestStep full s = some b ∧
      (remainingSet s).card * incidences ≤ ((q + 1) * w) * (killedSet s b).card := by
  have many : ∀ p ∈ remainingSet s, incidences ≤
      ((choices s).filter fun b => hitsPair b p).card := fun p hp =>
    many_choices s hs p ((mem_live (inst := full)).mp (List.mem_toFinset.mp hp)).1
  obtain ⟨someP, hsomeP⟩ := hnon
  have inc_pos : 0 < incidences := by decide
  have nonempty : (choices s).Nonempty :=
    (Finset.card_pos.mp (inc_pos.trans_le (many _ hsomeP))).mono (Finset.filter_subset ..)
  obtain ⟨b, hb, hAvg⟩ := greedy_average (remainingSet s) (choices s)
    (fun b p => hitsPair b p = true) nonempty incidences many
  have below : (remainingSet s).card * incidences ≤ (choices s).card * (killedSet s b).card :=
    (hAvg b hb).2
  have bpos : 0 < score full (live full s) b.1 b.2 := by
    rw [score_killed]
    apply Nat.pos_of_ne_zero
    intro hz
    rw [hz, Nat.mul_zero] at below
    exact (Nat.not_lt_zero _) ((Nat.mul_pos (Finset.card_pos.mpr ⟨_, hsomeP⟩) inc_pos).trans_le below)
  obtain ⟨best, hbest, hmax⟩ := exists_best (inst := full) (List.mem_toFinset.mp hb) bpos
  have hkill : (killedSet s b).card ≤ (killedSet s best).card := by
    rw [← score_killed, ← score_killed]
    exact hmax b (List.mem_toFinset.mp hb)
  exact ⟨best, hbest, below.trans (Nat.mul_le_mul (choices_card s) hkill)⟩

theorem counts_contract_aux {current next killed inc den : ℕ} (hd : 0 < den)
    (hnext : next + killed ≤ current) (hcnt : current * inc ≤ den * killed) :
    (next : ℝ) ≤ current * (1 - (inc : ℝ) / den) := by
  have hden : 0 < (den : ℝ) := by exact_mod_cast hd
  have hr : (current : ℝ) * ((inc : ℝ) / den) ≤ (killed : ℝ) := by
    rw [← mul_div_assoc, div_le_iff₀ hden, mul_comm (killed : ℝ) (den : ℝ)]
    exact_mod_cast hcnt
  have hnext' : (next : ℝ) + (killed : ℝ) ≤ (current : ℝ) := by exact_mod_cast hnext
  rw [mul_sub, mul_one]
  linarith only [hnext', hr]

theorem counts_contract {current next killed : ℕ} (hnext : next + killed ≤ current)
    (hcnt : current * incidences ≤ ((q + 1) * w) * killed) :
    (next : ℝ) ≤ current * (1 - removalFraction) := by
  unfold removalFraction
  exact counts_contract_aux (by decide : 0 < (q + 1) * w) hnext hcnt

theorem card_removed {α : Type*} [DecidableEq α] {old gone next : Finset α}
    (hsub : gone ⊆ old) (hnext : next ⊆ old \ gone) :
    next.card + gone.card ≤ old.card := by
  have hle := Finset.card_le_card hnext
  rw [Finset.card_sdiff_of_subset hsub] at hle
  exact (Nat.le_sub_iff_add_le (Finset.card_le_card hsub)).mp hle

theorem killed_subset (s : Shifts) (b : ℕ × ℕ) : killedSet s b ⊆ remainingSet s := by
  unfold killedSet
  exact Finset.filter_subset _ _

attribute [local irreducible] killedSet remainingSet advance

theorem advance_kills (s : Shifts) {b : ℕ × ℕ} (hb : bestStep full s = some b) :
    (remainingSet (advance full s)).card + (killedSet s b).card ≤ (remainingSet s).card := by
  have hmem : b ∈ choices s := List.mem_toFinset.mpr (best_mem (inst := full) hb)
  rw [advance, hb]
  exact card_removed (killed_subset s b) (remaining_after hmem)

theorem contract (s : Shifts) (hs : s.length ≤ steps + 2) :
    ((remainingSet (advance full s)).card : ℝ) ≤
      (remainingSet s).card * (1 - removalFraction) := by
  by_cases h₀ : (remainingSet s).card = 0
  · have hnext : (remainingSet (advance full s)).card = 0 := by
      cases h : bestStep full s with
      | none => simpa only [advance, h] using h₀
      | some b =>
        have he : (remainingSet (s ++ [b])).card ≤ (remainingSet s).card :=
          Finset.card_le_card (no_new_live s b)
        rw [h₀] at he
        simpa only [advance, h] using Nat.eq_zero_of_le_zero he
    simp only [h₀, hnext, Nat.cast_zero, zero_mul, le_refl]
  · obtain ⟨best, hbest, hcnt⟩ :=
      best_hits_bound s hs (Finset.card_pos.mp (Nat.pos_of_ne_zero h₀))
    have hnext := advance_kills (b := best) s hbest
    generalize hnow : (remainingSet s).card = now at hnext hcnt ⊢
    generalize hlater : (remainingSet (advance full s)).card = later at hnext ⊢
    generalize hgone : (killedSet s best).card = gone at hnext hcnt
    exact @counts_contract now later gone hnext hcnt

theorem run_length (t : ℕ) {inst : Instance} : (run inst t initial).length ≤ t + 2 := by
  induction t with
  | zero => simp [run, initial]
  | succ t ih =>
    rw [run_succ_end, advance]
    split
    · exact ih.trans (Nat.le_succ _)
    · simp only [List.length_append, List.length_singleton]
      exact Nat.succ_le_succ ih

theorem final_live_empty : (remainingSet (run full steps initial)).card = 0 := by
  refine greedyTerminates (fun t => (remainingSet (run full t initial)).card)
    (remaining_start (run full 0 initial)) ?_
  intro t ht
  simp only [run_succ_end]
  exact contract (run full t initial) ((run_length (inst := full) t).trans (Nat.add_le_add_right ht.le 2))

end Green14.Greedy

namespace Green14.Greedy

set_option maxRecDepth 4096

attribute [local irreducible] candidates bestStep run progressions live

theorem run_eligible (t : ℕ) :
    ∀ b ∈ run full t initial, eligible full b.1 = true ∧ b.2 < w := by
  induction t with
  | zero =>
    intro b hb
    rw [run] at hb
    change b ∈ [(0, 0), (1, 0)] at hb
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hb
    rcases hb with rfl | rfl <;> decide
  | succ t ih =>
    rw [run_succ_end, advance]
    split
    · exact ih
    · rename_i b hb
      have hc := mem_candidates.mp (best_mem hb)
      intro c he
      rcases List.mem_append.mp he with h | h
      · exact ih c h
      · have h' : c = b := by simpa using h
        subst c
        exact ⟨hc.2.1, hc.2.2.2⟩

theorem run_prefix (t : ℕ) : initial <+: run full t initial := by
  induction t with
  | zero => rw [run]
  | succ t ih =>
    rw [run_succ_end, advance]
    split
    · exact ih
    · exact ih.trans ⟨_, rfl⟩

def shiftAt (selected : Shifts) (a : ZMod v) : Option (ZMod w) :=
  (selected.find? (fun b => b.1 == a.val)).map (fun b => (b.2 : ZMod w))

abbrev finalShifts := shiftAt (run full steps initial)

theorem final_occupied (a : ZMod v) (s : ZMod w) (h : finalShifts a = some s) :
    a ∈ Singer.columns := by
  change shiftAt (run full steps initial) a = some s at h
  unfold shiftAt at h
  cases hfind : (run full steps initial).find? (fun b => b.1 == a.val) with
  | none => simp [hfind] at h
  | some b =>
    have hb := (run_eligible steps _ (List.mem_of_find?_eq_some hfind)).1
    have hbeq : (b.1 == a.val) = true :=
      List.find?_some (p := fun c : ℕ × ℕ => c.1 == a.val) hfind
    have he : b.1 = a.val := beq_iff_eq.mp hbeq
    simpa only [Singer.columns, Finset.mem_filter, Finset.mem_univ, true_and, ← he] using hb

theorem state_red (selected : Shifts) (hshift : ∀ b ∈ selected, b.2 < w) (n : ℕ) :
    isRed full selected n = true ↔ RedAt (shiftAt selected) n := by
  unfold RedAt shiftAt isRed
  rw [show full.v = v from rfl, ZMod.val_natCast]
  cases hf : selected.find? (fun b => b.1 == n % v) with
  | none => simp
  | some b =>
    have hb := hshift _ (List.mem_of_find?_eq_some hf)
    rcases b with ⟨a, b⟩
    rw [translation_spec _ _ hb]
    simp

theorem final_red (n : ℕ) : isRed full (run full steps initial) n = true ↔ RedAt finalShifts n :=
  state_red _ (fun b hb => (run_eligible steps b hb).2) n

theorem color_branch (selected : Shifts) (hpref : initial <+: selected)
    (selGood : ∀ b ∈ selected, eligible full b.1 = true) (n : ℕ) :
    (let a := n % v
     if a == 0 || a == 1 then inTranslation full (n / v) 0
     else if eligible full a then isRed full selected n else false) = isRed full selected n := by
  dsimp only
  let a := n % v
  change (if a == 0 || a == 1 then inTranslation full (n / v) 0
    else if eligible full a then isRed full selected n else false) = _
  by_cases h : a = 0 ∨ a = 1
  · have hp : initial.find? (fun b => b.1 == a) = some (a, 0) := by
      rcases h with h | h <;> simp [h, initial]
    have hf := hpref.find?_eq_some hp
    have his : isRed full selected n = inTranslation full (n / v) 0 := by
      unfold isRed
      rw [show full.v = v from rfl, ← show a = n % v from rfl, hf]
    rcases h with h | h <;> simp [h, his]
  · obtain ⟨h0, h1⟩ := not_or.mp h
    by_cases hgood : eligible full a = true
    · simp [h0, h1, hgood]
    · have hnone : selected.find? (fun b => b.1 == a) = none := by
        rw [List.find?_eq_none]
        intro b hb he
        have e := beq_iff_eq.mp he
        exact hgood (e ▸ selGood b hb)
      have his : isRed full selected n = false := by
        unfold isRed
        rw [show full.v = v from rfl, ← show a = n % v from rfl, hnone]
      simp [h0, h1, hgood, his]

theorem color_eq (n : ℕ) : color n = coloring finalShifts n := by
  classical
  let a := n % v
  let selected := run full steps initial
  have hred := color_branch selected (run_prefix steps) (fun b hb => (run_eligible steps b hb).1) n
  dsimp only at hred
  unfold color coloring
  change (if (if a == 0 || a == 1 then inTranslation full (n / v) 0
    else if eligible full a then isRed full selected n else false) then 0 else 1) = _
  rw [hred]
  by_cases h : isRed full selected n = true
  · simp [h, (final_red n).mp h]
  · have hn : ¬ RedAt finalShifts n := fun hr => h ((final_red n).mpr hr)
    simp [h, hn]

theorem final_cover (a d : ℕ) (ha : 1 ≤ a) (hd : 0 < d)
    (hl : a + (r - 1) * d ≤ N) :
    ∃ j < r, RedAt finalShifts (a + j * d) := by
  by_contra! h
  have hp : (a, d) ∈ progressions full := mem_progressions.mpr ⟨ha, hd, hl⟩
  have hLive : (a, d) ∈ remainingSet (run full steps initial) := List.mem_toFinset.mpr
    (mem_live.mpr ⟨hp, fun n hn => by
      obtain ⟨j, hj, rfl⟩ := mem_fields.mp hn
      exact Bool.eq_false_iff.mpr (fun he => h j hj ((final_red _).mp he))⟩)
  have hpos := Finset.card_pos.mpr ⟨_, hLive⟩
  rw [final_live_empty] at hpos
  exact (Nat.lt_irrefl 0) hpos

theorem answer_valid : ValidAnswer answer := by
  have hc := valid_of_cover (Singer.columns : Set (ZMod v))
    Singer.columns_uniqueDifferences.columnsFree finalShifts final_occupied final_cover
  simpa only [answer, color_eq] using hc

end Green14.Greedy

