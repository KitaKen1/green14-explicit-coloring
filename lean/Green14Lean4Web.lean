  subst sz
  have hremxy := (ZMod.natCast_eq_natCast_iff' _ _ _).mp hxy
  have hremzy := (ZMod.natCast_eq_natCast_iff' _ _ _).mp hzy
  have split (n : ℕ) : v * (n / v) + n % v = n := Nat.div_add_mod n v
  have hsx' := split x
  have hsy' := split y
  have hsz' := split z
