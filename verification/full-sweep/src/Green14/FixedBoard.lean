theorem recorded_runs_repaired (g : Run) (hg : g ∈ recordedRuns) : Covered g := by
  obtain ⟨b,_,hg⟩ := List.mem_flatMap.mp hg
  obtain ⟨m,hm,rfl⟩ := List.mem_map.mp hg
  exact b.checked m hm

theorem board_all_hit_of_base_sweep (hs : Complete recordedRuns) :
    Green14.FiniteBoard.allHit R redAt :=
  all_hit_of_complete recordedRuns hs recorded_runs_repaired

