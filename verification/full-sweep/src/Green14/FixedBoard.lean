def lookup (c : Nat) : Nat × Nat × Nat := (records.find? (fun t => t.1 == c)).getD (0,0,0)
def factor (c : Nat) : Nat := (lookup c).2.1
def shift (c : Nat) : Nat := (lookup c).2.2
set_option maxRecDepth 25000 in
set_option maxHeartbeats 12000000 in
private theorem unit_table : records.all (fun q => decide (q.2.1 = 0 ∨ Nat.gcd 88985 q.2.1 = 1)) = true := by decide +kernel

theorem units (c : Nat) (h : factor c ≠ 0) : Nat.gcd 88985 (factor c) = 1 := by
  cases he : records.find? (fun t => t.1 == c) with
  | none => simp [factor,lookup,he] at h
  | some t =>
    have ht := List.mem_of_find?_eq_some he
    have hh := List.all_eq_true.mp unit_table t ht
    simp only [decide_eq_true_eq] at hh
    simp [factor,lookup,he] at h ⊢
    exact hh.resolve_left h

abbrev R : Nat := 177147
abbrev P : Nat := 354301
abbrev W : Nat := 88985

def isRed (patch : Nat → Nat → Prop) :=
  red P W (· ∈ columnKeys) (· ∈ baseMask) factor shift patch

theorem red_safe (patch : Nat → Nat → Prop)
    (safe : ∀ c, c ∈ columnKeys → factor c = 0 → ∀ x y z, patch c x → patch c y →
      patch c z → x+z = y+y → x = y)
    (a d : Nat) (hd : 0 < d) (hn : a+d+d ≤ 2*R^2-1)
    (r₀ : isRed patch a) (r₁ : isRed patch (a+d)) (r₂ : isRed patch (a+d+d)) : False :=
  no_red_triple (by decide : 0 < P) (by decide : 2*R^2-1 < 2*(P*W))
    columnKeys_cap baseMask_cap (fun c _ => units c) safe hd hn r₀ r₁ r₂

theorem base_red_safe (a d : Nat) (hd : 0 < d) (hn : a+d+d ≤ 2*R^2-1)
    (r₀ : isRed (fun _ _ => False) a) (r₁ : isRed (fun _ _ => False) (a+d))
    (r₂ : isRed (fun _ _ => False) (a+d+d)) : False :=
  red_safe _ (fun _ _ _ _ _ _ h => h.elim) a d hd hn r₀ r₁ r₂

