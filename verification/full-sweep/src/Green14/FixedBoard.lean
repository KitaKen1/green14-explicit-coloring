namespace Green14Search.Medium

/-- All modular triples among these representatives are constant. -/
def Cap (m : Nat) (S : Nat → Prop) : Prop := ∀ x, S x → ∀ y, S y → ∀ z, S z →
  x+z ≡ y+y [MOD m] → x = y ∧ z = y

/-- Test a singleton mask without dividing the larger integer. -/
def hasBit (n i : Nat) : Bool := decide ((n &&& 2^i) = 2^i)

private theorem hasBit_true (n i : Nat) : hasBit n i = true ↔ n.testBit i = true := by
  simp only [hasBit, decide_eq_true_eq]
  constructor
  · intro h
    simpa [Nat.testBit_and, Nat.testBit_two_pow_self] using congrArg (fun x : Nat => x.testBit i) h
  · intro h
    apply Nat.eq_of_testBit_eq
    intro j
    by_cases hij : i = j
    · subst j; simp [h, Nat.testBit_two_pow_self]
    · simp [hij]

/-- A forward mask and a doubled reflected mask certify one centre at a time. -/
def bitCheck (m f b y : Nat) : Bool := decide (y < m) && hasBit f y &&
  hasBit b (m-1-y) && hasBit b (2*m-1-y) &&
  decide (((f <<< (m-1-((y+y)%m))) &&& b) = 2^((m-1-((y+y)%m))+y))

private theorem pick {m f b x y z : Nat}
    (hx : bitCheck m f b x) (hy : bitCheck m f b y) (hz : bitCheck m f b z)
    (h : x+z ≡ y+y [MOD m]) : x = y := by
  simp only [bitCheck, Bool.and_eq_true, decide_eq_true_eq, hasBit_true] at hx hy hz
  obtain ⟨⟨⟨⟨xm, fx⟩, _⟩, _⟩, _⟩ := hx
  obtain ⟨⟨⟨⟨ym, _⟩, _⟩, _⟩, cut⟩ := hy
  obtain ⟨⟨⟨⟨zm, _⟩, bz⟩, bz'⟩, _⟩ := hz
  have hm : 0 < m := by omega
  have hy' : (y+y)%m < m := Nat.mod_lt _ hm
  have hh : (x+z)%m = (y+y)%m := h
  have hbit : b.testBit (m-1-((y+y)%m)+x) = true := by
    by_cases hsum : x+z < m
    · rw [Nat.mod_eq_of_lt hsum] at hh
      rw [show m-1-((y+y)%m)+x = m-1-z by omega]; exact bz
    · rw [Nat.mod_eq_sub_mod (by omega), Nat.mod_eq_of_lt (by omega)] at hh
      rw [show m-1-((y+y)%m)+x = 2*m-1-z by omega]; exact bz'
  have see := congrArg (fun n : Nat => n.testBit ((m-1-((y+y)%m))+x)) cut
  simpa [Nat.testBit_and, Nat.testBit_shiftLeft, fx, hbit, Nat.testBit_two_pow, eq_comm] using see

theorem cap_of_check {m f b : Nat} {S : Nat → Prop} (verified : ∀ x, S x → bitCheck m f b x) : Cap m S := by
  intro x hx y hy z hz h
  exact ⟨pick (verified x hx) (verified y hy) (verified z hz) h,
    pick (verified z hz) (verified y hy) (verified x hx) (by simpa [Nat.add_comm] using h)⟩

/-- Certifies one midpoint of an ordinary row set with largest row at most H.
The reversed mask has a bit at 2*H-z for every allowed endpoint z. -/
def rowCheck (H f b y : Nat) : Bool := decide (y ≤ H) && hasBit f y &&
  hasBit b (2*H-y) && decide (((f <<< (2*H-(y+y))) &&& b) = 2^((2*H-(y+y))+y))

theorem rows_of_check {H f b : Nat} {S : Nat → Prop} (verified : ∀ t, S t → rowCheck H f b t)
    {x y z : Nat} (hx : S x) (hy : S y) (hz : S z) (ap : x+z = y+y) : x = y := by
  have vx := verified x hx
  have vy := verified y hy
  have vz := verified z hz
  simp only [rowCheck, Bool.and_eq_true, decide_eq_true_eq, hasBit_true] at vx vy vz
  obtain ⟨⟨⟨_, fx⟩, _⟩, _⟩ := vx
  obtain ⟨⟨⟨ym, _⟩, _⟩, cut⟩ := vy
  obtain ⟨⟨⟨zm, _⟩, rz⟩, _⟩ := vz
  have bit : b.testBit (2*H-(y+y)+x) = true := by
    rw [show 2*H-(y+y)+x = 2*H-z by omega]; exact rz
  have see := congrArg (fun n : Nat => n.testBit ((2*H-(y+y))+x)) cut
  simpa [Nat.testBit_and, Nat.testBit_shiftLeft, fx, bit, Nat.testBit_two_pow, eq_comm] using see

/-- A row list with a directly checkable proof for use in a reserved column. -/
structure RowCertificate where
  rows : List Nat
  height : Nat
  forward : Nat
  backward : Nat
  checked : rows.all (rowCheck height forward backward) = true

def emptyRows : RowCertificate := ⟨[],0,0,0,rfl⟩

def rowBits (rows : List Nat) : Nat := rows.foldl (fun n x => n ||| (1 <<< x)) 0

theorem RowCertificate.noTriple (c : RowCertificate) {x y z : Nat}
    (hx : x ∈ c.rows) (hy : y ∈ c.rows) (hz : z ∈ c.rows) (ap : x+z = y+y) : x = y :=
  rows_of_check (List.all_eq_true.mp c.checked) hx hy hz ap

/-- The column and affine mask representation of the archive. A zero multiplier
selects the list of added rows in its reserved column. -/
def red (p w : Nat) (columns mask : Nat → Prop) (factor shift : Nat → Nat)
    (patch : Nat → Nat → Prop) (n : Nat) : Prop :=
  let c := n%p
  columns c ∧ (if factor c = 0 then patch c (n/p)
    else ∃ k, mask k ∧ n/p ≡ factor c*k+shift c [MOD w])

private theorem affine_rows {w f h x y z : Nat} {mask : Nat → Prop} (cf : Nat.gcd w f = 1)
    (free : Cap w mask) (ap : x+z = y+y)
    (hx : ∃ k, mask k ∧ x ≡ f*k+h [MOD w])
    (hy : ∃ k, mask k ∧ y ≡ f*k+h [MOD w])
    (hz : ∃ k, mask k ∧ z ≡ f*k+h [MOD w]) : x ≡ y [MOD w] := by
  obtain ⟨i, hi, ix⟩ := hx
  obtain ⟨j, hj, jy⟩ := hy
  obtain ⟨k, hk, kz⟩ := hz
  have sums := (ix.add kz).symm.trans ((show x+z ≡ y+y [MOD w] by rw [ap]).trans (jy.add jy))
  have ex : f*(i+k)+(h+h) ≡ f*(j+j)+(h+h) [MOD w] := by
    simpa only [Nat.mul_add, Nat.add_add_add_comm] using sums
  have eq := (free i hi j hj k hk (Nat.ModEq.cancel_left_of_coprime cf (ex.add_right_cancel' _))).1
  subst j
  exact ix.trans jy.symm

/-- Red safety on an ordinary interval of length less than two periods. -/
theorem no_red_triple {p w N : Nat} (hp : 0 < p) (room : N < 2*(p*w))
    {columns mask : Nat → Prop} {factor shift : Nat → Nat} {patch : Nat → Nat → Prop}
    (cc : Cap p columns) (cm : Cap w mask)
    (units : ∀ c, columns c → factor c ≠ 0 → Nat.gcd w (factor c) = 1)
    (patchFree : ∀ c, columns c → factor c = 0 → ∀ x y z, patch c x → patch c y →
      patch c z → x+z = y+y → x = y)
    {a d : Nat} (hd : 0 < d) (hn : a+d+d ≤ N)
    (r₀ : red p w columns mask factor shift patch a)
    (r₁ : red p w columns mask factor shift patch (a+d))
    (r₂ : red p w columns mask factor shift patch (a+d+d)) : False := by
  let b := a+d
  let e := a+d+d
  have hsum : a+e = b+b := by dsimp [b,e]; omega
  change columns (a%p) ∧ _ at r₀
  change columns (b%p) ∧ _ at r₁
  change columns (e%p) ∧ _ at r₂
  have rems : a%p+e%p ≡ b%p+b%p [MOD p] :=
    ((Nat.mod_modEq a p).add (Nat.mod_modEq e p)).trans
      ((show a+e ≡ b+b [MOD p] by rw [hsum]).trans ((Nat.mod_modEq b p).add (Nat.mod_modEq b p)).symm)
  obtain ⟨xab, xeb⟩ := cc _ r₀.1 _ r₁.1 _ r₂.1 rems
  have ha := Nat.div_add_mod a p
  have hb := Nat.div_add_mod b p
  have he := Nat.div_add_mod e p
  have rows : a/p+e/p = b/p+b/p := by
    apply Nat.eq_of_mul_eq_mul_left hp
    rw [Nat.mul_add, Nat.mul_add]; omega
  obtain ⟨_, ra⟩ := r₀
  obtain ⟨cb, rb⟩ := r₁
  obtain ⟨_, re⟩ := r₂
  change (if factor (a%p) = 0 then _ else _) at ra
  change (if factor (b%p) = 0 then _ else _) at rb
  change (if factor (e%p) = 0 then _ else _) at re
  rw [xab] at ra
  rw [xeb] at re
  by_cases empty : factor (b%p) = 0
  · simp only [empty, ite_true] at ra rb re
    have eq := patchFree _ cb empty (a/p) (b/p) (e/p) ra rb re rows
    have : a = b := by rw [eq, xab] at ha; omega
    dsimp [b] at this; omega
  · simp only [empty, ite_false] at ra rb re
    have same := affine_rows (units _ cb empty) cm rows ra rb re
    have div : w ∣ b/p-a/p := (Nat.modEq_iff_dvd' (Nat.div_le_div_right (by dsimp [b]; omega : a ≤ b))).mp same
    obtain ⟨k, hk⟩ := div
    have le : a/p ≤ b/p := Nat.div_le_div_right (by dsimp [b]; omega)
    have ne : a/p ≠ b/p := by
      intro eq
      rw [eq, xab] at ha
      dsimp [b] at ha hb ⊢; omega
    have ge : w ≤ b/p-a/p := Nat.le_of_dvd (by omega) ⟨k,hk⟩
    have dp : p*w ≤ p*(b/p-a/p) := Nat.mul_le_mul_left _ ge
    rw [Nat.mul_sub] at dp
    dsimp [b,e] at ha hb he xab xeb dp
    omega

end Green14Search.Medium

