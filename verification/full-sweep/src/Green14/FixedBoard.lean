theorem final_red_safe (a d : Nat) (hd : 0 < d) (hn : a+d+d ≤ 2*R^2-1)
    (r₀ : finalRed a) (r₁ : finalRed (a+d)) (r₂ : finalRed (a+d+d)) : False :=
  red_safe _ (fun c _ _ _ _ _ hx hy hz hap => (patchFibre c).noTriple
