/-! The finite-computation criterion used for the moderate-size archive, in the
language of the pinned Formal Conjectures progression and answer definitions. -/
namespace Green14.FiniteBoard

def color (red : ℕ → Bool) (x : ℕ) : Fin 2 := if red x then 0 else 1

def answer (r : ℕ) (red : ℕ → Bool) : Answer := ⟨r, fun x => color red x.val⟩

def allHit (r : ℕ) (red : ℕ → Bool) : Prop :=
  ∀ a d : ℕ, 1 ≤ a → 0 < d → a+(r-1)*d ≤ 2*r^2-1 → ∃ j < r, red (a+j*d) = true

theorem valid_iff_allHit (r : ℕ) (red : ℕ → Bool) (hr : 3 ≤ r)
    (redSafe : ∀ a d : ℕ, 0 < d → a+d+d ≤ 2*r^2-1 →
      red a = true → red (a+d) = true → red (a+d+d) = true → False) :
    ValidAnswer (answer r red) ↔ allHit r red := by
  let N := 2*r^2-1
  have hk : 2 ≤ r := by omega
  constructor
  · intro hv a d ha hd hend
    by_contra! hm
    apply hv.2
    apply Or.inr
    apply (hasMono_iff (N:=N) hk (color red) 1).mpr
    exact ⟨a,d,ha,hd,hend,fun j hj => by simp [color, hm j hj]⟩
  · intro h
    refine ⟨hr, ?_⟩
    rintro (hr₃ | hblue)
    · obtain ⟨a,d,_,hd,hend,hm⟩ :=
        (hasMono_iff (N:=N) (by decide : 2 ≤ 3) (color red) 0).mp hr₃
      have isRed (j : ℕ) (hj : j < 3) : red (a+j*d) = true := by
        by_contra hn
        simpa [color, hn] using hm j hj
      apply redSafe a d hd (by simpa [N, two_mul, Nat.add_assoc] using hend)
      · simpa using isRed 0 (by decide)
      · simpa using isRed 1 (by decide)
      · simpa [two_mul,Nat.add_assoc] using isRed 2 (by decide)
    · obtain ⟨a,d,ha,hd,hend,hm⟩ := (hasMono_iff (N:=N) hk (color red) 1).mp hblue
      obtain ⟨j,hj,hred⟩ := h a d ha hd hend
      simpa [color, hred] using hm j hj

end Green14.FiniteBoard

/-! The precise remaining Lean computation for the fixed board. The theorem
below is an equivalence. Exhaustive numerical gap scans are separate evidence. -/
namespace Green14Search.Medium.Fixed

def finiteAnswer : Green14.Answer := Green14.FiniteBoard.answer R redAt

theorem fc_iff_blue_coverage :
    Green14.ValidAnswer finiteAnswer ↔ Green14.FiniteBoard.allHit R redAt := by
  apply Green14.FiniteBoard.valid_iff_allHit R redAt (by decide)
  intro a d hd he r0 r1 r2
  exact final_red_safe a d hd he ((redAt_iff _).mp r0) ((redAt_iff _).mp r1) ((redAt_iff _).mp r2)

end Green14Search.Medium.Fixed

/-! Repairing a complete list of exceptional blue runs of the base colouring.
One fixed red point in the common intersection of all length-R windows in a
run certifies every such window, including the first and last. -/
namespace Green14Search.Medium.Fixed.Repair
open Green14Search.Medium

structure Run where
  first : Nat
  step : Nat
  terms : Nat

structure Mark where
  run : Run
  index : Nat

def Covered (g : Run) : Prop :=
  ∀ k, k+R ≤ g.terms → ∃ j < R, finalRed (g.first+k*g.step+j*g.step)

/-- A finite tuple from the exported gap list, with an index pointing
at a patch that belongs to every length-R window in that run. -/
def markOK (c : Nat) (m : Mark) : Bool :=
  let n := m.run.first + m.index*m.run.step
  decide (m.run.terms ≤ m.index+R ∧ m.index < R ∧ n%P = c ∧ n/P ∈ literalRows c)

theorem covered_of_mark {c : Nat} {m : Mark} (hc : c ∈ columnKeys) (hf : factor c = 0)
    (hm : markOK c m = true) : Covered m.run := by
  let n := m.run.first + m.index*m.run.step
  have ⟨ht,hi,hcol,hrow⟩ := of_decide_eq_true hm
  have hr : finalRed n := by
    change n%P ∈ columnKeys ∧ (if factor (n%P) = 0 then n/P ∈ literalRows (n%P) else _)
    rw [show n%P = c from hcol, hf, ite_eq_left rfl]
    exact ⟨hc,hrow⟩
  intro k hk
  have hki : k ≤ m.index := by omega
  refine ⟨m.index-k, by omega, ?_⟩
  have hsum : k + (m.index-k) = m.index := by omega
  rwa [Nat.add_assoc, ← Nat.add_mul, hsum]

def baseRed := isRed (fun _ _ => False)

theorem red_of_base {n : Nat} (hn : baseRed n) : finalRed n := by
  obtain ⟨hc,hb⟩ := hn
  refine ⟨hc, ?_⟩
  change (if factor (n%P) = 0 then n/P ∈ literalRows (n%P) else _)
  split <;> rename_i hf
  · simp [hf] at hb
  · simpa only [hf, Bool.false_eq_true, ↓reduceIte] using hb

/-- Every legal length-R progression that misses the base red set is a
window of one of the runs returned by the base sweep. -/
def Complete (runs : List Run) : Prop :=
  ∀ a d : Nat, 1 ≤ a → 0 < d → a+(R-1)*d ≤ 2*R^2-1 →
    (∀ j < R, ¬baseRed (a+j*d)) →
    ∃ g ∈ runs, ∃ k, k+R ≤ g.terms ∧ a = g.first+k*d ∧ g.step = d

theorem all_hit_of_complete (runs : List Run) (full : Complete runs)
    (repaired : ∀ g ∈ runs, Covered g) : Green14.FiniteBoard.allHit R redAt := by
  intro a d ha hd he
  by_cases found : ∃ j < R, baseRed (a+j*d)
  · obtain ⟨j,hj,hred⟩ := found
    exact ⟨j,hj,(redAt_iff _).mpr (red_of_base hred)⟩
  · push Not at found
    obtain ⟨g,hg,k,hk,ha',hd'⟩ := full a d ha hd he found
    obtain ⟨j,hj,hred⟩ := repaired g hg k hk
    rw [hd'] at hred
    exact ⟨j,hj,(redAt_iff _).mpr (ha' ▸ hred)⟩

end Green14Search.Medium.Fixed.Repair

