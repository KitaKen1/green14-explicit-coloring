def literalTable : Table := part1288

private theorem table_repr : literalTable.inOrder = records := by decide +kernel

def mask (c : Nat) : Nat :=
  match literalTable.search c with
  | none => 0
  | some v => if v.2.1 = 0 then 0 else FastMask.digitMask v.2.1 v.2.2

theorem sound (patch : Nat → Nat → Prop) (n : Nat)
    (hit : (mask (n%P)).testBit (n/P%W) = true) : isRed patch n := by
  cases hs : literalTable.search (n%P) with
  | none => simp [mask, hs] at hit
  | some v =>
    obtain ⟨hc,hf,hh,_⟩ := lookup_sound table_repr hs
    by_cases hz : v.2.1 = 0
    · simp [mask, hs, hz] at hit
    · have hm : (FastMask.digitMask v.2.1 v.2.2).testBit (n/P%W) = true := by
        simpa only [mask, hs, ite_eq_right hz] using hit
      obtain ⟨k,hk,he⟩ := FastMask.digitMask_sound (Nat.mod_lt _ (by decide)) hm
      refine ⟨hc, ?_⟩
      rw [hf, hh, ite_eq_right hz]
      exact ⟨k,hk,he.symm⟩

theorem maskUnion_append (x y : List Nat) : maskUnion W P 2 mask (x++y) =
    maskUnion W P 2 mask x ||| maskUnion W P 2 mask y := by
  induction x with
  | nil => simp [maskUnion]
  | cons t ts ih => simp [maskUnion, ih, Nat.or_assoc]

